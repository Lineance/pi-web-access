{
  "name": "@laboon85/pi-web-access",
  "version": "0.9.1",
  "description": "Web search and web fetch for the pi coding agent, built around a tiered provider fallback chain.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "web-search",
    "web-fetch",
    "search",
    "fetch",
    "fallback"
  ],
  "type": "module",
  "license": "MIT",
  "author": "laboon85",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lineance/pi-web-access.git"
  },
  "homepage": "https://github.com/Lineance/pi-web-access#readme",
  "bugs": {
    "url": "https://github.com/Lineance/pi-web-access/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/**",
    "docs/config.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node -e \"import('./dist/index.js').then((m) => { if (typeof m.default !== 'function') { console.error('dist/index.js default export is not a function'); process.exit(1); } console.log('smoke ok'); })\"",
    "pack:check": "node scripts/verify-pack.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build && npm run smoke"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "typebox": "*"
  },
  "dependencies": {
    "@mixmark-io/domino": "2.2.0",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "5.0.6",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
